---
interface Props {
  label: string;
  htmlFor: string;
  required?: boolean;
  hint?: string;
  error?: string;
  class?: string;
}

const {
  label,
  htmlFor,
  required = false,
  hint,
  error,
  class: className = '',
} = Astro.props;
---

<div class={`field ${className}`.trim()}>
  <label class="field__label" for={htmlFor}>
    {label}
    {required && <span class="field__required" aria-hidden="true">*</span>}
  </label>

  <slot />

  {hint && !error && (
    <p class="field__hint" id={`${htmlFor}-hint`}>{hint}</p>
  )}

  {error && (
    <p class="field__error" id={`${htmlFor}-error`} role="alert">
      {error}
    </p>
  )}
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .field__label {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text-primary);
    letter-spacing: var(--ls-normal);
  }

  .field__required {
    color: var(--color-accent);
    margin-left: 2px;
  }

  .field__hint {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
  }

  .field__error {
    font-size: var(--fs-xs);
    color: #f87171;
    line-height: var(--lh-normal);
  }
</style>
