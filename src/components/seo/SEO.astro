---
import { SITE } from '@/lib/site';
import { graph, personSchema, websiteSchema, organizationSchema } from '@/lib/schema';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  structuredData?: Record<string, unknown>[];
}

const {
  title = SITE.defaults.title,
  description = SITE.defaults.description,
  canonical,
  image,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  author,
  structuredData = [],
} = Astro.props;

const pageTitle = title === SITE.defaults.title ? title : `${title} — Savflux`;
const canonicalURL = canonical
  ? new URL(canonical, Astro.site)
  : new URL(Astro.url.pathname, Astro.site);

// Dynamic OG image path (or explicit override if `image` was provided)
const dynamicOgPath = `/og${canonicalURL.pathname.replace(/\/$/, '')}.png`;
const ogImageURL = image
  ? new URL(image, Astro.site)
  : new URL(dynamicOgPath, Astro.site);

// Build the full structured-data graph for this page
const baseGraph = graph(
  personSchema(),
  websiteSchema(),
  organizationSchema(),
  ...structuredData,
);
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Savflux" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={pageTitle} />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{author && <meta property="article:author" content={author} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={pageTitle} />

<!-- Misc -->
<meta name="theme-color" content="#07090F" />
<meta name="color-scheme" content="dark" />
<meta name="generator" content={Astro.generator} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="Savflux — Writing" href="/rss.xml" />
<!-- Search engine verification -->
<meta name="msvalidate.01" content="36B59C8C06B4ED3CBBC7BB97D82AB324" />

<!-- JSON-LD structured data -->
<script type="application/ld+json" set:html={JSON.stringify(baseGraph)} />
