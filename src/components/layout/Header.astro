---
import { SITE } from '@/lib/site';

const pathname = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="header" role="banner">
  <div class="container header__inner">
    <a href="/" class="header__brand" aria-label="Savflux — home">
      <span class="header__mark">SF</span>
      <span class="header__wordmark">SAVFLUX</span>
    </a>

    <nav class="header__nav" aria-label="Primary">
      <ul class="header__list">
        {SITE.nav.primary.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['header__link', { 'header__link--active': isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      class="header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      data-menu-toggle
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="header__mobile" id="mobile-menu" hidden data-menu>
    <ul class="header__mobile-list">
      {SITE.nav.primary.map((item) => (
        <li>
          <a href={item.href} class="header__mobile-link">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    gap: var(--space-6);
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-tighter);
    font-size: var(--fs-md);
  }

  .header__brand:hover {
    color: var(--color-text-primary);
  }

  .header__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-md);
    background: var(--color-surface-2);
    color: var(--color-accent);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0;
    border: 1px solid var(--color-border-strong);
  }

  .header__wordmark {
    font-weight: var(--fw-bold);
  }

  .header__list {
    display: none;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 900px) {
    .header__list {
      display: flex;
    }
  }

  .header__link {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--color-text-secondary);
    transition:
      color var(--duration-micro) var(--ease-standard),
      background var(--duration-micro) var(--ease-standard);
  }

  .header__link:hover {
    color: var(--color-text-primary);
    background: var(--color-surface);
  }

  .header__link--active {
    color: var(--color-accent);
  }

  .header__toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: var(--space-2);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .header__toggle span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: var(--color-text-primary);
    transition: transform var(--duration-micro) var(--ease-standard);
  }

  @media (min-width: 900px) {
    .header__toggle {
      display: none;
    }
  }

  .header__mobile {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .header__mobile-list {
    list-style: none;
    margin: 0;
    padding: var(--space-4) var(--gutter-mobile);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .header__mobile-link {
    display: block;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    font-size: var(--fs-md);
    font-weight: var(--fw-medium);
  }

  .header__mobile-link:hover {
    background: var(--color-surface);
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
      menu.hidden = isOpen;
    });
  }
</script>
