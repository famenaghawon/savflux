---
interface Props {
  direction?: 'vertical' | 'horizontal';
  gap?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  align?: 'start' | 'center' | 'end' | 'stretch' | 'baseline';
  justify?: 'start' | 'center' | 'end' | 'between' | 'around';
  wrap?: boolean;
  class?: string;
}

const {
  direction = 'vertical',
  gap = 'md',
  align,
  justify,
  wrap = false,
  class: className = '',
} = Astro.props;

const classes = [
  'stack',
  `stack--dir-${direction}`,
  `stack--gap-${gap}`,
  align && `stack--align-${align}`,
  justify && `stack--justify-${justify}`,
  wrap && 'stack--wrap',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<div class={classes}>
  <slot />
</div>

<style>
  .stack {
    display: flex;
  }
  .stack--dir-vertical {
    flex-direction: column;
  }
  .stack--dir-horizontal {
    flex-direction: row;
  }

  .stack--gap-xs {
    gap: var(--space-2);
  }
  .stack--gap-sm {
    gap: var(--space-3);
  }
  .stack--gap-md {
    gap: var(--space-4);
  }
  .stack--gap-lg {
    gap: var(--space-6);
  }
  .stack--gap-xl {
    gap: var(--space-10);
  }

  .stack--align-start {
    align-items: flex-start;
  }
  .stack--align-center {
    align-items: center;
  }
  .stack--align-end {
    align-items: flex-end;
  }
  .stack--align-stretch {
    align-items: stretch;
  }
  .stack--align-baseline {
    align-items: baseline;
  }

  .stack--justify-start {
    justify-content: flex-start;
  }
  .stack--justify-center {
    justify-content: center;
  }
  .stack--justify-end {
    justify-content: flex-end;
  }
  .stack--justify-between {
    justify-content: space-between;
  }
  .stack--justify-around {
    justify-content: space-around;
  }

  .stack--wrap {
    flex-wrap: wrap;
  }
</style>
