---
import { Image as AstroImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync' | 'auto';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  aspectRatio?: string;
  quality?: number;
  width?: number;
  height?: number;
  fallback?: boolean;
}

const {
  src,
  alt,
  widths = [320, 640, 960, 1280, 1600],
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 1200px',
  loading = 'lazy',
  decoding = 'async',
  fetchpriority = 'auto',
  class: className = '',
  aspectRatio,
  quality = 80,
  width,
  height,
  fallback = false,
} = Astro.props;

const style = aspectRatio ? `aspect-ratio: ${aspectRatio};` : '';
const isMetadata = typeof src !== 'string';
---

{isMetadata ? (
  <AstroImage
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    quality={quality}
    format="webp"
    class={className}
    style={style}
  />
) : (
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    class={className}
    style={style}
  />
)}

<style>
  :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
</style>
