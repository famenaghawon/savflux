---
interface Props {
  as?: 'div' | 'article' | 'section' | 'a';
  href?: string;
  padding?: 'none' | 'sm' | 'md' | 'lg';
  interactive?: boolean;
  class?: string;
}

const {
  as = 'div',
  href,
  padding = 'md',
  interactive = false,
  class: className = '',
} = Astro.props;

const Tag = href ? 'a' : as;
const classes = [
  'card',
  `card--pad-${padding}`,
  interactive || href ? 'card--interactive' : '',
  className,
].filter(Boolean).join(' ');
---

<Tag class={classes} href={href}>
  <slot />
</Tag>

<style>
  .card {
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--duration-micro) var(--ease-standard),
      background var(--duration-micro) var(--ease-standard),
      transform var(--duration-micro) var(--ease-standard);
  }

  .card--pad-none { padding: 0; }
  .card--pad-sm   { padding: var(--space-4); }
  .card--pad-md   { padding: var(--space-6); }
  .card--pad-lg   { padding: var(--space-8); }

  .card--interactive {
    cursor: pointer;
  }

  .card--interactive:hover {
    border-color: var(--color-border-strong);
    background: color-mix(in srgb, var(--color-surface) 85%, var(--color-surface-2));
    transform: translateY(-2px);
  }

  .card--interactive:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .card, .card--interactive { transition: none; transform: none; }
  }
</style>
