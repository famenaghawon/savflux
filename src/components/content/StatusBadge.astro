---
import Badge from '@/components/ui/Badge.astro';

interface Props {
  status: 'idea' | 'research' | 'prototype' | 'building' | 'live' | 'archived';
  class?: string;
}

const { status, class: className } = Astro.props;

const map = {
  idea:      { variant: 'default', label: 'Idea' },
  research:  { variant: 'info',    label: 'Research' },
  prototype: { variant: 'warning', label: 'Prototype' },
  building:  { variant: 'accent',  label: 'Building' },
  live:      { variant: 'success', label: 'Live' },
  archived:  { variant: 'default', label: 'Archived' },
} as const;

const { variant, label } = map[status];
---

<Badge variant={variant} dot class={className}>{label}</Badge>
