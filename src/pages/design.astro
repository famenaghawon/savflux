---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/primitives/Container.astro';
import Section from '@/components/primitives/Section.astro';
import Grid from '@/components/primitives/Grid.astro';
import Stack from '@/components/primitives/Stack.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import Card from '@/components/ui/Card.astro';
import Chip from '@/components/ui/Chip.astro';
import Tag from '@/components/ui/Tag.astro';
import Divider from '@/components/ui/Divider.astro';
import ProjectCard from '@/components/content/ProjectCard.astro';
import ArticleCard from '@/components/content/ArticleCard.astro';
import ExperimentCard from '@/components/content/ExperimentCard.astro';
import Timeline from '@/components/content/Timeline.astro';
import Field from '@/components/forms/Field.astro';
import Input from '@/components/forms/Input.astro';
import Textarea from '@/components/forms/Textarea.astro';
import Select from '@/components/forms/Select.astro';
import Checkbox from '@/components/forms/Checkbox.astro';
import Radio from '@/components/forms/Radio.astro';
import Icon from '@/components/icons/Icon.astro';

const icons = [
  'arrow-right', 'arrow-up-right', 'external-link', 'mail', 'menu', 'x', 'search',
  'plus', 'minus', 'check', 'chevron-right', 'chevron-down', 'chevron-up',
  'circle', 'clock', 'calendar', 'tag', 'layers',
  'cpu', 'database', 'cloud', 'code', 'terminal', 'sparkles', 'zap', 'rocket',
  'flask-conical', 'beaker', 'microscope',
  'file-text', 'book-open', 'play', 'video', 'globe', 'link', 'send',
  'info', 'circle-alert', 'circle-check', 'circle-x',
] as const;

const timelineEntries = [
  { year: '2026', title: 'Founded PrimeShieldHub', description: 'Building technology-driven commerce for gadgets and enterprise procurement.' },
  { year: '2025', title: 'BuildMart enterprise platform', description: 'Digital operating system for construction material procurement.' },
  { year: '2024', title: 'Computational biology research', description: 'Bioinformatics pipelines, data science, and cancer biomarker discovery.' },
];

const sampleStack = ['Astro', 'TypeScript', 'Cloudflare Workers', 'D1', 'Tailwind'];
---

<BaseLayout
  title="Design System"
  description="The Savflux design system — components, tokens, and primitives."
  noindex
>
  <Section spacing="md">
    <Container>
      <p class="eyebrow">Savflux · Internal</p>
      <h1 style="margin-top: var(--space-4);">Design System</h1>
      <p class="lead">
        Every component, every variant, every state. This page is the source of truth
        for the Savflux visual language. It is <strong>noindex</strong> — never appears in search.
      </p>
    </Container>
  </Section>

  <!-- BUTTONS -->
  <Section spacing="md" background="surface">
    <Container>
      <h2>Buttons</h2>
      <Divider />

      <Stack gap="lg">
        <Stack direction="horizontal" gap="sm" wrap align="center">
          <Button variant="primary">Primary</Button>
          <Button variant="secondary">Secondary</Button>
          <Button variant="ghost">Ghost</Button>
          <Button variant="danger">Danger</Button>
          <Button variant="link">Link</Button>
        </Stack>

        <Stack direction="horizontal" gap="sm" wrap align="center">
          <Button size="sm" variant="primary">Small</Button>
          <Button size="md" variant="primary">Medium</Button>
          <Button size="lg" variant="primary">Large</Button>
        </Stack>

        <Stack direction="horizontal" gap="sm" wrap align="center">
          <Button variant="primary" icon="arrow-right">With icon</Button>
          <Button variant="ghost" icon="code" iconPosition="left">GitHub</Button>
          <Button variant="primary" loading>Loading</Button>
          <Button variant="primary" disabled>Disabled</Button>
        </Stack>
      </Stack>
    </Container>
  </Section>

  <!-- BADGES -->
  <Section spacing="md">
    <Container>
      <h2>Badges</h2>
      <Divider />

      <Stack gap="lg">
        <Stack direction="horizontal" gap="sm" wrap>
          <Badge>Default</Badge>
          <Badge variant="accent">Accent</Badge>
          <Badge variant="success">Success</Badge>
          <Badge variant="warning">Warning</Badge>
          <Badge variant="danger">Danger</Badge>
          <Badge variant="info">Info</Badge>
        </Stack>

        <Stack direction="horizontal" gap="sm" wrap>
          <Badge variant="accent" dot>Building</Badge>
          <Badge variant="success" dot>Live</Badge>
          <Badge variant="warning" dot>Prototype</Badge>
        </Stack>
      </Stack>
    </Container>
  </Section>

  <!-- TAGS & CHIPS -->
  <Section spacing="md" background="surface">
    <Container>
      <h2>Tags & Chips</h2>
      <Divider />

      <Stack gap="lg">
        <Stack direction="horizontal" gap="sm" wrap>
          <Tag>astro</Tag>
          <Tag>typescript</Tag>
          <Tag>cloudflare</Tag>
          <Tag>tailwind</Tag>
        </Stack>

        <Stack direction="horizontal" gap="sm" wrap>
          <Chip>All</Chip>
          <Chip active>Software</Chip>
          <Chip>AI</Chip>
          <Chip>Data</Chip>
          <Chip>Cloud</Chip>
        </Stack>
      </Stack>
    </Container>
  </Section>

  <!-- CARDS -->
  <Section spacing="md">
    <Container>
      <h2>Cards</h2>
      <Divider />
      <Grid cols={3} gap="md">
        <Card><h3>Card — default</h3><p>Standard surface. Nothing interactive.</p></Card>
        <Card interactive><h3>Card — interactive</h3><p>Hover lifts the card by 2px.</p></Card>
        <Card href="/"><h3>Card — link</h3><p>Wraps in an anchor, keeps semantics.</p></Card>
      </Grid>
    </Container>
  </Section>

  <!-- STATUS BADGES -->
  <Section spacing="md" background="surface">
    <Container>
      <h2>Status Badges</h2>
      <Divider />
      <Stack direction="horizontal" gap="sm" wrap>
        <Badge variant="default" dot>Idea</Badge>
        <Badge variant="info" dot>Research</Badge>
        <Badge variant="warning" dot>Prototype</Badge>
        <Badge variant="accent" dot>Building</Badge>
        <Badge variant="success" dot>Live</Badge>
        <Badge variant="default" dot>Archived</Badge>
      </Stack>
    </Container>
  </Section>

  <!-- PROJECT CARDS -->
  <Section spacing="md">
    <Container>
      <h2>Project Cards</h2>
      <Divider />
      <Grid cols={2} gap="md">
        <ProjectCard
          title="PrimeShieldHub"
          summary="Technology-driven commerce infrastructure for gadgets, wholesale, and enterprise procurement."
          href="/work/primeshieldhub"
          year={2025}
          status="live"
          category="Software · Cloud"
          stack={sampleStack}
        />
        <ProjectCard
          title="Ajo / Esusu Platform"
          summary="Digital infrastructure for cooperative savings and contribution management."
          href="/work/ajo"
          year={2026}
          status="prototype"
          category="Fintech"
          stack={['Cloudflare', 'D1', 'Gemini', 'WhatsApp API']}
        />
      </Grid>
    </Container>
  </Section>

  <!-- ARTICLE CARDS -->
  <Section spacing="md" background="surface">
    <Container>
      <h2>Article Cards</h2>
      <Divider />
      <Grid cols={2} gap="md">
        <ArticleCard
          title="My Journey From Microbiology to Technology"
          description="Why a bioinformatics researcher ended up building technology businesses."
          href="/writing/microbiology-to-technology"
          category="Story"
          readingTime={8}
          date="Oct 2026"
        />
        <ArticleCard
          title="How I Approach Building Digital Systems"
          description="Requirements, architecture, APIs, security, iteration."
          href="/writing/building-digital-systems"
          category="Engineering"
          readingTime={12}
          date="Sep 2026"
        />
      </Grid>
    </Container>
  </Section>

  <!-- EXPERIMENT CARDS -->
  <Section spacing="md">
    <Container>
      <h2>Experiment Cards</h2>
      <Divider />
      <Grid cols={3} gap="md">
        <ExperimentCard
          title="AI Business Assistant"
          summary="Exploring how AI can help Nigerian SMEs automate customer service."
          href="/lab/ai-business-assistant"
          status="research"
          updatedAt="2 weeks ago"
        />
        <ExperimentCard
          title="Savflux AI"
          summary="RAG-based assistant over Savflux's own content."
          href="/lab/savflux-ai"
          status="idea"
          updatedAt="1 month ago"
        />
        <ExperimentCard
          title="AI Commerce Engine"
          summary="Automating product discovery and customer intent."
          href="/lab/ai-commerce-engine"
          status="building"
          updatedAt="3 days ago"
        />
      </Grid>
    </Container>
  </Section>

  <!-- TIMELINE -->
  <Section spacing="md" background="surface">
    <Container>
      <h2>Timeline</h2>
      <Divider />
      <Timeline entries={timelineEntries} />
    </Container>
  </Section>

  <!-- FORMS -->
  <Section spacing="md">
    <Container>
      <h2>Forms</h2>
      <Divider />
      <Stack gap="lg">
        <Field label="Full name" htmlFor="demo-name" required hint="Enter your first and last name">
          <Input id="demo-name" name="name" placeholder="Freedom Amenaghawon" />
        </Field>

        <Field label="Email" htmlFor="demo-email" required>
          <Input id="demo-email" name="email" type="email" placeholder="you@example.com" />
        </Field>

        <Field label="Subject" htmlFor="demo-subject" required>
          <Select
            id="demo-subject"
            name="subject"
            options={[
              { value: '', label: 'Choose a topic' },
              { value: 'project', label: 'Project enquiry' },
              { value: 'collab', label: 'Collaboration' },
              { value: 'speaking', label: 'Speaking' },
              { value: 'press', label: 'Press' },
            ]}
          />
        </Field>

        <Field label="Message" htmlFor="demo-message" required>
          <Textarea id="demo-message" name="message" placeholder="Tell me what you're working on…" />
        </Field>

        <Field label="Email — invalid state" htmlFor="demo-email-err" error="Please enter a valid email address">
          <Input id="demo-email-err" name="email_err" type="email" value="not-an-email" error />
        </Field>

        <Divider label="Preferences" />

        <Stack gap="sm">
          <Checkbox id="demo-check-1" name="prefs" label="Email me about new experiments" checked />
          <Checkbox id="demo-check-2" name="prefs" label="Send monthly newsletter" />
        </Stack>

        <Stack gap="sm">
          <Radio id="demo-radio-1" name="freq" label="Weekly" value="weekly" checked />
          <Radio id="demo-radio-2" name="freq" label="Monthly" value="monthly" />
          <Radio id="demo-radio-3" name="freq" label="Never" value="never" />
        </Stack>

        <Divider />

        <Stack direction="horizontal" gap="sm" wrap>
          <Button type="submit" variant="primary" icon="send">Send message</Button>
          <Button variant="ghost">Cancel</Button>
        </Stack>
      </Stack>
    </Container>
  </Section>

  <!-- ICONS -->
  <Section spacing="md" background="surface">
    <Container>
      <h2>Icons</h2>
      <Divider />
      <Grid cols={4} gap="md">
        {icons.map((name) => (
          <Card padding="sm">
            <Stack direction="horizontal" gap="sm" align="center">
              <Icon name={name} size={20} />
              <code style="font-size: 0.75rem;">{name}</code>
            </Stack>
          </Card>
        ))}
      </Grid>
    </Container>
  </Section>

  <!-- MOTION -->
  <Section spacing="md">
    <Container>
      <h2>Motion · Reveal on scroll</h2>
      <Divider />
      <Stack gap="lg">
        {[1, 2, 3, 4].map((i) => (
          <Card data-reveal data-reveal-delay={String(i)} padding="lg">
            <h3>Reveal item {i}</h3>
            <p>Scroll-triggered. Respects <code>prefers-reduced-motion</code>.</p>
          </Card>
        ))}
      </Stack>
    </Container>
  </Section>
</BaseLayout>
