---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Technology Lab · Est. 2026</p>
      <h1>
        I build technology that
        <br />
        turns ideas into working systems.
      </h1>
      <p class="lead">
        Technology entrepreneur, full-stack developer and builder exploring software, AI, data,
        cloud infrastructure and digital systems.
      </p>

      <div class="hero__cta">
        <a href="/work" class="btn btn--primary">
          Explore My Work
        </a>
        <a href="/lab" class="btn btn--ghost">
          Enter the Lab
        </a>
      </div>

      <p class="hero__founder">
        Founder of
        <a href="https://primeshieldhub.com" rel="noopener">
          PrimeShieldHub →
        </a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Phase 1 · Foundation Live</p>
      <p class="lead" style="margin-top: var(--space-4);">
        The foundation is deployed. Design system, pages and content engine arrive in Phases 2–4.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-24) var(--space-16);
    background: var(--gradient-hero);
    position: relative;
    overflow: hidden;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: var(--gradient-accent-line);
    opacity: 0.4;
  }

  .hero h1 {
    margin-top: var(--space-5);
    margin-bottom: var(--space-6);
    max-width: 18ch;
  }

  .hero .lead {
    margin-bottom: var(--space-10);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .hero__founder {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    font-family: var(--font-mono);
    letter-spacing: var(--ls-wide);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-normal);
    text-decoration: none;
    transition: all var(--duration-micro) var(--ease-standard);
    border: 1px solid transparent;
  }

  .btn--primary {
    background: var(--color-accent);
    color: var(--color-text-inverse);
  }

  .btn--primary:hover {
    background: var(--color-accent-hover);
    color: var(--color-text-inverse);
    box-shadow: var(--shadow-accent);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-text-primary);
    border-color: var(--color-border-strong);
  }

  .btn--ghost:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-tint);
  }
</style>
