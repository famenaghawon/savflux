---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/primitives/Container.astro';
import Section from '@/components/primitives/Section.astro';
import Stack from '@/components/primitives/Stack.astro';
import Button from '@/components/ui/Button.astro';
import Field from '@/components/forms/Field.astro';
import Input from '@/components/forms/Input.astro';
import Textarea from '@/components/forms/Textarea.astro';
import Select from '@/components/forms/Select.astro';
import { SITE } from '@/lib/site';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Freedom Amenaghawon — project enquiries, collaboration, speaking, press."
  canonical="/contact/"
>
  <Section spacing="md">
    <Container width="narrow">
      <Stack gap="md">
        <span class="eyebrow">Contact</span>
        <h1>Get in touch.</h1>
        <p class="lead">
          Project enquiries, collaborations, speaking invitations, or just a
          thoughtful question about something on the site. I read everything.
        </p>
      </Stack>
    </Container>
  </Section>

  <Section spacing="md" background="surface">
    <Container width="narrow">
      <form class="contact-form" action="#" method="post" novalidate>
        <Stack gap="lg">
          <Field label="Name" htmlFor="name" required>
            <Input id="name" name="name" type="text" placeholder="Your name" required />
          </Field>

          <Field label="Email" htmlFor="email" required>
            <Input id="email" name="email" type="email" placeholder="you@example.com" required />
          </Field>

          <Field label="Subject" htmlFor="subject" required>
            <Select
              id="subject"
              name="subject"
              options={[
                { value: '', label: 'Choose a topic' },
                { value: 'project', label: 'Project enquiry' },
                { value: 'collab', label: 'Collaboration' },
                { value: 'speaking', label: 'Speaking' },
                { value: 'press', label: 'Press' },
                { value: 'other', label: 'Other' },
              ]}
            />
          </Field>

          <Field label="Message" htmlFor="message" required hint="What would you like to discuss?">
            <Textarea id="message" name="message" placeholder="Tell me what you're working on…" required />
          </Field>

          <Stack direction="horizontal" gap="sm" wrap>
            <Button type="submit" variant="primary" icon="send">Send message</Button>
          </Stack>
        </Stack>
      </form>
    </Container>
  </Section>

  <Section spacing="md">
    <Container width="narrow">
      <Stack gap="md">
        <span class="eyebrow">Direct</span>
        <Stack gap="sm">
          <p class="contact-direct">
            <span class="contact-direct__label">Email</span>
            <a href={`mailto:${SITE.author.email}`} class="contact-direct__value">{SITE.author.email}</a>
          </p>
          <p class="contact-direct">
            <span class="contact-direct__label">GitHub</span>
            <a href={SITE.author.github} class="contact-direct__value" target="_blank" rel="noopener">github.com/famenaghawon</a>
          </p>
          <p class="contact-direct">
            <span class="contact-direct__label">ORCID</span>
            <span class="contact-direct__value">{SITE.author.orcid}</span>
          </p>
        </Stack>
      </Stack>
    </Container>
  </Section>
</BaseLayout>

<style>
  .contact-form { max-width: 100%; }

  .contact-direct {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  @media (min-width: 640px) {
    .contact-direct {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-6);
    }
  }

  .contact-direct__label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
    min-width: 80px;
  }

  .contact-direct__value {
    font-size: var(--fs-sm);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  a.contact-direct__value:hover { color: var(--color-accent); }
</style>
