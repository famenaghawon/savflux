---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/primitives/Container.astro';
import Section from '@/components/primitives/Section.astro';
import Stack from '@/components/primitives/Stack.astro';
import Prose from '@/components/content/Prose.astro';
---

<BaseLayout
  title="Accessibility"
  description="Savflux's commitment to WCAG 2.2 AA accessibility — keyboard navigation, screen reader support, and assistive technology compatibility."
  canonical="/accessibility/"
>
  <Section spacing="md">
    <Container width="narrow">
      <Stack gap="md">
        <span class="eyebrow">Accessibility</span>
        <h1>Accessibility statement.</h1>
        <p class="lead">
          Savflux aims to be usable by everyone, regardless of ability or assistive technology. This
          page documents what we've built and how to report barriers.
        </p>
      </Stack>
    </Container>
  </Section>

  <Section spacing="md" background="surface">
    <Container width="narrow">
      <Prose>
        <h2>Standards</h2>
        <p>
          Savflux targets <strong>WCAG 2.2 Level AA</strong> compliance. Every page is tested with
          automated tools (axe, Lighthouse, WAVE) and manually with keyboard-only navigation and
          screen readers.
        </p>

        <h2>What we've implemented</h2>
        <ul>
          <li>Semantic HTML with correct landmark structure</li>
          <li>
            One <code>&lt;h1&gt;</code> per page and logical heading hierarchy
          </li>
          <li>Visible focus indicators on every interactive element</li>
          <li>Full keyboard navigation — no mouse-only interactions</li>
          <li>Skip links to jump past repetitive navigation</li>
          <li>
            Descriptive <code>alt</code> text on all meaningful images
          </li>
          <li>Sufficient color contrast (≥ 4.5:1 body, ≥ 3:1 large text)</li>
          <li>
            <code>prefers-reduced-motion</code> respected throughout
          </li>
          <li>Accessible forms with proper labels and error messaging</li>
          <li>Screen reader announcements for dynamic content</li>
          <li>Touch targets at least 44×44 CSS pixels</li>
        </ul>

        <h2>Testing</h2>
        <p>Accessibility is verified at every release using:</p>
        <ul>
          <li>Automated: axe-core, Lighthouse, WAVE</li>
          <li>Manual: keyboard-only navigation, NVDA, VoiceOver</li>
          <li>Color: contrast checks against WCAG 2.2 AA thresholds</li>
        </ul>

        <h2>Known limitations</h2>
        <p>
          As of the current release, we are not aware of any unresolved accessibility barriers. If
          you encounter one, please report it.
        </p>

        <h2>Feedback</h2>
        <p>
          If you experience any accessibility barrier on Savflux, please{' '}
          <a href="/contact">contact us</a>. We take all reports seriously and aim to respond within
          5 business days.
        </p>

        <p>
          <em>Last reviewed: October 2026</em>
        </p>
      </Prose>
    </Container>
  </Section>
</BaseLayout>
