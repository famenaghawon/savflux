---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/primitives/Container.astro';
import Section from '@/components/primitives/Section.astro';
import Stack from '@/components/primitives/Stack.astro';
import StatusBadge from '@/components/content/StatusBadge.astro';
import Prose from '@/components/content/Prose.astro';
import Breadcrumbs from '@/components/content/Breadcrumbs.astro';
import RelatedContent from '@/components/content/RelatedContent.astro';
import ShareButtons from '@/components/content/ShareButtons.astro';
import { getRelatedContent } from '@/lib/related';
import type { CollectionEntry } from 'astro:content';
import { experimentSchema } from '@/lib/schema';

interface Props {
  experiment: CollectionEntry<'experiments'>;
}

const { experiment } = Astro.props;
const { data } = experiment;

const startedDate = data.startedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
const updatedDate = data.updatedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const related = await getRelatedContent({
  type: 'experiment',
  id: experiment.id,
  tags: data.tags,
  category: data.category,
  relatedArticles: data.relatedArticles,
});

const canonicalURL = new URL(`/lab/${experiment.id}/`, Astro.site).toString();
---

<BaseLayout
  title={data.title}
  description={data.summary}
  type="article"
  canonical={`/lab/${experiment.id}/`}
  structuredData={[
    experimentSchema({
      url: new URL(`/lab/${experiment.id}/`, Astro.site).toString(),
      title: data.title,
      summary: data.summary,
      category: data.category,
      tags: data.tags,
      startedAt: data.startedAt.toISOString(),
      updatedAt: data.updatedAt.toISOString(),
    }),
  ]}
>
  <Section spacing="md">
    <Container width="narrow">
      <Stack gap="lg">
        <Breadcrumbs crumbs={[
          { label: 'Home', href: '/' },
          { label: 'Lab', href: '/lab' },
          { label: data.title },
        ]} />

        <Stack gap="md">
          <Stack direction="horizontal" gap="sm" wrap align="center">
            <StatusBadge status={data.status} />
            <span class="lab-meta">{data.category}</span>
            <span class="lab-meta">Started {startedDate}</span>
          </Stack>

          <h1>{data.title}</h1>
          <p class="lead">{data.summary}</p>
          <p class="lab-updated">Last updated {updatedDate}</p>
        </Stack>

        {data.tags.length > 0 && (
          <Stack direction="horizontal" gap="sm" wrap>
            {data.tags.map((tag) => <span class="lab-tag">{tag}</span>)}
          </Stack>
        )}
      </Stack>
    </Container>
  </Section>

  <Section spacing="md" background="surface">
    <Container width="narrow">
      <Prose>
        <slot />
      </Prose>
    </Container>
  </Section>

  <Section spacing="md">
    <Container width="narrow">
      <ShareButtons url={canonicalURL} title={data.title} />
      <p class="lab-author">
        Experiment by <a href="/about" rel="author"><strong>Freedom Amenaghawon</strong></a>
      </p>
      <RelatedContent items={related} />
    </Container>
  </Section>
</BaseLayout>

<style>
  .lab-meta {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-wider);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .lab-updated {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }
  
  .lab-author {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
  }

  .lab-author a {
    color: var(--color-text-primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-micro) var(--ease-standard);
  }

  .lab-author a:hover {
    border-bottom-color: var(--color-accent);
    color: var(--color-accent);
  }


  .lab-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 3px 8px;
    letter-spacing: var(--ls-wide);
  }
</style>
