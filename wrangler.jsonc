{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "savflux",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "e7dfb113844a4bc0a91d350044743f7a"
    }
  ],
  "routes": [
    {
      "pattern": "savflux.com",
      "custom_domain": true
    },
    {
      "pattern": "www.savflux.com",
      "custom_domain": true
    }
  ]
}
