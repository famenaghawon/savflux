{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "savflux",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "savflux.com",
      "custom_domain": true
    },
    {
      "pattern": "www.savflux.com",
      "custom_domain": true
    }
  ]
}
